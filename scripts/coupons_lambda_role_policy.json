{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateCouponLogGroups",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/coupons*"
    },
    {
      "Sid": "WriteCouponFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/coupons*:log-stream:*"
    },
    {
      "Sid": "AccessCouponsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/coupons",
        "arn:aws:dynamodb:us-east-1:000000000000:table/coupons/index/*"
      ]
    }
  ]
}
